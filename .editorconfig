; This file is for unifying the coding style for different editors and IDEs.
; More information at http://editorconfig.org

root = true

[*]
charset = utf-8
indent_size = 4
indent_style = space
end_of_line = lf
insert_final_newline = false
trim_trailing_whitespace = true

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2
insert_final_newline = true

[Makefile*]
indent_style = tab
indent_size = 2

[*.mk]
indent_style = tab
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false
max_line_length = 150
